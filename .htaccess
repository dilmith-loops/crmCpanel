Options -Indexes
DirectoryIndex public/index.php index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /crmdemo/

    # Allow direct access if already pointing to public/
    RewriteCond %{REQUEST_URI} ^/crmdemo/public/
    RewriteRule ^ - [L]

    # Block sensitive folders
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]

    # Serve static assets directly from public/ if they exist
    RewriteCond %{DOCUMENT_ROOT}/crmdemo/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public_html/crmdemo/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Send all other requests to public/index.php
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "(composer\.(json|lock|phar)|package(-lock)?\.json|artisan|error_log|phpunit\.xml|cpanel-deploy\.sh|\.cpanel\.yml)$">
    Require all denied
</FilesMatch>
